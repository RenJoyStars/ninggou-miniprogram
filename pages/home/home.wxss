/* ============================================================
   宁狗在哪 · 小程序端样式 · v3.3
   设计基调对齐 Apple「查找」：
   - Flex 弹性撑满（零手算高度误差，.map-wrap min-height: 0 防止矮屏挤掉页脚）
   - 五档全终端自适应比例：
     · layout-mini    华为折叠屏外屏 / 超小屏（<=320宽 或 <=520高）：极简头尾、绝不裁切
     · layout-compact iPhone SE / 小屏手机
     · layout-regular 常规 6.1"~6.5" 手机
     · layout-large   Pro Max / Ultra 大屏手机
     · layout-tablet  iPad / 平板 / 折叠屏内屏：100% 铺满大屏，地图视野舒展
   ============================================================ */

/* ---------- 设计变量 ---------- */
page, body {
  --bg: #f2f2f7;
  --card: #ffffff;
  --text: #1c1c1e;
  --text2: #8a8a8e;
  --text3: #aeaeb2;
  --accent: #007aff;
  --green: #34c759;
  --accent-soft: rgba(0, 122, 255, .14);
  --green-soft: rgba(52, 199, 89, .14);
  --hairline: rgba(60, 60, 67, .11);
  --card-border: rgba(60, 60, 67, .08);
  --ctrl-bg: rgba(255, 255, 255, .94);
  --pressed: rgba(0, 0, 0, .06);
  --shadow-card: 0 2px 6px rgba(0, 0, 0, .04), 0 14px 32px -16px rgba(0, 0, 0, .24);
  --spinner-track: #e5e5ea;

  /* 比例变量（默认 regular 常规 6.1"~6.5" 机型） */
  --side-gap: 14px;
  --card-radius: 20px;
  --head-h: 52px;
  --head-px: 16px;
  --title-size: 16px;
  --label-size: 12px;
  --footer-py: 14px;
  --footer-icon: 48px;
  --footer-radius: 13px;
  --pin-w: 60px;
  --pin-h: 77px;
  --pin-half-w: 30px;
  --pin-anchor-y: 64px;
  --zoom-w: 44px;
  --zoom-icon: 20px;
  --zoom-gap: 14px;
}

@media (prefers-color-scheme: dark) {
  page, body {
    --bg: #000000;
    --card: #1c1c1e;
    --text: #ffffff;
    --text2: #98989f;
    --text3: #6e6e73;
    --accent: #0a84ff;
    --green: #30d158;
    --accent-soft: rgba(10, 132, 255, .22);
    --green-soft: rgba(48, 209, 88, .20);
    --hairline: rgba(84, 84, 88, .50);
    --card-border: rgba(255, 255, 255, .08);
    --ctrl-bg: rgba(44, 44, 46, .94);
    --pressed: rgba(255, 255, 255, .10);
    --shadow-card: 0 2px 6px rgba(0, 0, 0, .45), 0 14px 32px -16px rgba(0, 0, 0, .85);
    --spinner-track: #3a3a3c;
  }
}

/* JS 兜底：部分安卓 webview 不响应 prefers-color-scheme */
.theme-dark {
  --bg: #000000;
  --card: #1c1c1e;
  --text: #ffffff;
  --text2: #98989f;
  --text3: #6e6e73;
  --accent: #0a84ff;
  --green: #30d158;
  --accent-soft: rgba(10, 132, 255, .22);
  --green-soft: rgba(48, 209, 88, .20);
  --hairline: rgba(84, 84, 88, .50);
  --card-border: rgba(255, 255, 255, .08);
  --ctrl-bg: rgba(44, 44, 46, .94);
  --pressed: rgba(255, 255, 255, .10);
  --shadow-card: 0 2px 6px rgba(0, 0, 0, .45), 0 14px 32px -16px rgba(0, 0, 0, .85);
  --spinner-track: #3a3a3c;
}

/* ---------- 五档全终端比例适配 ---------- */

/* 1. 超小屏 / 华为折叠屏外屏（<=320px 宽或 <=520px 高）：极简高密度，确保所有元素清晰可见不被挤出屏外 */
.layout-mini {
  --side-gap: 6px;
  --card-radius: 14px;
  --head-h: 38px;
  --head-px: 10px;
  --title-size: 13px;
  --label-size: 11px;
  --footer-py: 6px;
  --footer-icon: 28px;
  --footer-radius: 8px;
  --pin-w: 44px;
  --pin-h: 56px;
  --pin-half-w: 22px;
  --pin-anchor-y: 47px;
  --zoom-w: 34px;
  --zoom-icon: 16px;
  --zoom-gap: 8px;
}
.layout-mini .card-label {
  display: none;
}
.layout-mini .pill {
  height: 20px;
  line-height: 20px;
  padding: 0 7px;
  margin-left: 4px;
}
.layout-mini .refresh-btn {
  width: 28px;
  height: 28px;
  border-radius: 14px;
  margin-left: 4px;
}
.layout-mini .refresh-icon {
  width: 13px;
  height: 13px;
}
.layout-mini .footer-sub,
.layout-mini .footer-copy {
  display: none;
}
.layout-mini .footer {
  gap: 8px;
}

/* 2. 紧凑小屏（iPhone SE / 小屏安卓） */
.layout-compact {
  --side-gap: 10px;
  --card-radius: 16px;
  --head-h: 46px;
  --head-px: 14px;
  --title-size: 15px;
  --label-size: 11px;
  --footer-py: 10px;
  --footer-icon: 42px;
  --footer-radius: 11px;
  --pin-w: 54px;
  --pin-h: 69px;
  --pin-half-w: 27px;
  --pin-anchor-y: 58px;
  --zoom-w: 40px;
  --zoom-icon: 18px;
  --zoom-gap: 10px;
}

/* 3. 超大屏手机（Pro Max / Ultra） */
.layout-large {
  --side-gap: 16px;
  --card-radius: 22px;
  --head-h: 56px;
  --head-px: 18px;
  --title-size: 17px;
  --label-size: 12px;
  --footer-py: 16px;
  --footer-icon: 52px;
  --footer-radius: 14px;
  --pin-w: 64px;
  --pin-h: 82px;
  --pin-half-w: 32px;
  --pin-anchor-y: 68px;
  --zoom-w: 46px;
  --zoom-icon: 20px;
  --zoom-gap: 16px;
}

/* 4. 平板 / iPad / 折叠屏展开内屏（>=560px）：全幅铺满屏幕，视野舒展 */
.layout-tablet {
  --side-gap: 20px;
  --card-radius: 22px;
  --head-h: 58px;
  --head-px: 22px;
  --title-size: 18px;
  --label-size: 13px;
  --footer-py: 16px;
  --footer-icon: 52px;
  --footer-radius: 14px;
  --pin-w: 68px;
  --pin-h: 87px;
  --pin-half-w: 34px;
  --pin-anchor-y: 72px;
  --zoom-w: 48px;
  --zoom-icon: 22px;
  --zoom-gap: 18px;
}

/* ---------- 基础 ---------- */
page {
  height: 100%;
  overflow: hidden;
  background: var(--bg);
  color: var(--text);
  -webkit-text-size-adjust: 100%;
}

.page {
  display: -webkit-flex;
  display: flex;
  -webkit-flex-direction: column;
  flex-direction: column;
  -webkit-align-items: center;
  align-items: center;
  height: 100%;
  width: 100%;
  box-sizing: border-box;
  overflow: hidden;
  background: var(--bg);
}

/* 全幅弹性壳层：平板/折叠屏铺满 100% 宽度，不再把地图限制成窄条 */
.shell {
  display: -webkit-flex;
  display: flex;
  -webkit-flex-direction: column;
  flex-direction: column;
  width: 100%;
  height: 100%;
  padding-left: var(--side-gap);
  padding-right: var(--side-gap);
  box-sizing: border-box;
}

/* ---------- 加载态 / 空态 ---------- */
.fullpage {
  display: -webkit-flex;
  display: flex;
  -webkit-flex-direction: column;
  flex-direction: column;
  -webkit-align-items: center;
  align-items: center;
  -webkit-justify-content: center;
  justify-content: center;
  height: 100%;
  padding: 0 24px;
  box-sizing: border-box;
  background: var(--bg);
}

.spinner {
  width: 26px;
  height: 26px;
  margin-bottom: 14px;
  border: 2.5px solid var(--spinner-track);
  border-top-color: var(--accent);
  border-radius: 50%;
  -webkit-animation: spin .72s linear infinite;
  animation: spin .72s linear infinite;
}
@-webkit-keyframes spin { to { -webkit-transform: rotate(1turn); } }
@keyframes spin { to { transform: rotate(1turn); } }

.spinner-text {
  font-size: 14px;
  line-height: 1.4;
  color: var(--text2);
}

.empty-avatar {
  width: 68px;
  height: 68px;
  margin-bottom: 16px;
  border-radius: 17px;
  box-shadow: var(--shadow-card);
}
.empty-title {
  font-size: 17px;
  font-weight: 600;
  line-height: 1.3;
  color: var(--text);
}
.empty-desc {
  margin-top: 8px;
  font-size: 14px;
  line-height: 1.5;
  text-align: center;
  color: var(--text2);
}

.btn-primary {
  display: -webkit-flex;
  display: flex;
  -webkit-align-items: center;
  align-items: center;
  -webkit-justify-content: center;
  justify-content: center;
  margin-top: 22px;
  width: 180px;
  height: 44px;
  border-radius: 22px;
  background: var(--accent);
  color: #ffffff;
  font-size: 15px;
  font-weight: 500;
  letter-spacing: .2px;
}
.btn-hover { opacity: .78; }

/* ---------- 地图卡片（Flex 弹性撑满剩余高度） ---------- */
.card {
  display: -webkit-flex;
  display: flex;
  -webkit-flex-direction: column;
  flex-direction: column;
  -webkit-flex: 1;
  flex: 1;
  min-height: 0;
  width: 100%;
  background: var(--card);
  border-radius: var(--card-radius);
  border: 0.5px solid var(--card-border);
  overflow: hidden;
  box-shadow: var(--shadow-card);
  box-sizing: border-box;
}

.card-head {
  display: -webkit-flex;
  display: flex;
  -webkit-align-items: center;
  align-items: center;
  height: var(--head-h);
  padding: 0 var(--head-px);
  -webkit-flex-shrink: 0;
  flex-shrink: 0;
  box-sizing: border-box;
}

/* 状态蓝点 + 纯 CSS 柔和呼吸光环 */
.dot-wrap {
  position: relative;
  width: 14px;
  height: 14px;
  margin-right: 7px;
  display: -webkit-flex;
  display: flex;
  -webkit-align-items: center;
  align-items: center;
  -webkit-justify-content: center;
  justify-content: center;
  -webkit-flex-shrink: 0;
  flex-shrink: 0;
}

.dot-ring {
  position: absolute;
  width: 14px;
  height: 14px;
  border-radius: 50%;
  background: var(--accent-soft);
  -webkit-animation: dotPulse 2.4s ease-out infinite;
  animation: dotPulse 2.4s ease-out infinite;
}

@-webkit-keyframes dotPulse {
  0%   { -webkit-transform: scale(.75); opacity: .9; }
  70%  { -webkit-transform: scale(1.45); opacity: 0; }
  100% { -webkit-transform: scale(1.45); opacity: 0; }
}
@keyframes dotPulse {
  0%   { transform: scale(.75); opacity: .9; }
  70%  { transform: scale(1.45); opacity: 0; }
  100% { transform: scale(1.45); opacity: 0; }
}

.dot {
  position: relative;
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--accent);
}

.card-name {
  -webkit-flex-shrink: 0;
  flex-shrink: 0;
  font-size: var(--title-size);
  font-weight: 600;
  line-height: 1.3;
  color: var(--text);
}

.head-right {
  margin-left: auto;
  display: -webkit-flex;
  display: flex;
  -webkit-align-items: center;
  align-items: center;
  min-width: 0;
}

.card-label {
  padding-left: 6px;
  font-size: var(--label-size);
  line-height: 1.3;
  color: var(--text2);
  white-space: nowrap;
}

/* 时间胶囊：轻点可切换绝对时间 / 相对时间 */
.pill {
  margin-left: 6px;
  -webkit-flex-shrink: 0;
  flex-shrink: 0;
  height: 24px;
  padding: 0 10px;
  border-radius: 12px;
  font-size: var(--label-size);
  font-weight: 500;
  line-height: 24px;
  white-space: nowrap;
  font-variant-numeric: tabular-nums;
  background: var(--green-soft);
  color: var(--green);
}
.pill-hover { opacity: .72; }

/* 卡片头部刷新按钮（放大触控热区防误触时间胶囊） */
.refresh-btn {
  margin-left: 6px;
  width: 34px;
  height: 34px;
  border-radius: 17px;
  display: -webkit-flex;
  display: flex;
  -webkit-align-items: center;
  align-items: center;
  -webkit-justify-content: center;
  justify-content: center;
  -webkit-flex-shrink: 0;
  flex-shrink: 0;
  background: var(--pressed);
}
.refresh-hover { opacity: .65; }

.refresh-icon {
  width: 15px;
  height: 15px;
  display: block;
}

.refresh-btn.is-spinning .refresh-icon {
  -webkit-animation: spin .72s linear infinite;
  animation: spin .72s linear infinite;
}

/* ---------- 地图（min-height: 0 保证超矮外屏不挤出页脚） ---------- */
.map-wrap {
  position: relative;
  -webkit-flex: 1;
  flex: 1;
  min-height: 0;
  border-top: 0.5px solid var(--hairline);
  overflow: hidden;
}

.map-canvas {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  width: 100%;
  height: 100%;
}

/* 手势锁 */
.touch-blocker {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(255, 255, 255, 0.001);
}

/* 浅/深色统一浮动图钉：尖角精确对齐地图几何中心 (50%, 50%) */
.pin-marker {
  position: absolute;
  left: calc(50% - var(--pin-half-w));
  top: calc(50% - var(--pin-anchor-y));
  width: var(--pin-w);
  height: var(--pin-h);
  z-index: 10;
  pointer-events: none;
}

/* 深色底图遮罩（iOS 轻压暗保留路网，Android 完整压暗） */
@media (prefers-color-scheme: dark) {
  .touch-blocker {
    background-color: rgba(10, 14, 23, 0.68);
  }
  .platform-ios .touch-blocker {
    background-color: rgba(10, 14, 23, 0.26);
  }
  .zoom {
    border-color: rgba(84, 84, 88, 0.55);
    background-color: rgba(44, 44, 46, 0.94);
  }
  .zoom-hr {
    background-color: rgba(84, 84, 88, 0.55);
  }
}

.theme-dark .touch-blocker {
  background-color: rgba(10, 14, 23, 0.68);
}
.theme-dark.platform-ios .touch-blocker {
  background-color: rgba(10, 14, 23, 0.26);
}
.theme-dark .zoom {
  border-color: rgba(84, 84, 88, 0.55);
  background-color: rgba(44, 44, 46, 0.94);
}
.theme-dark .zoom-hr {
  background-color: rgba(84, 84, 88, 0.55);
}

/* ---------- 缩放功能条 ---------- */
.zoom {
  position: absolute;
  right: var(--zoom-gap);
  bottom: var(--zoom-gap);
  width: var(--zoom-w);
  border-radius: 13px;
  border: 1px solid rgba(60, 60, 67, 0.14);
  background-color: rgba(255, 255, 255, 0.96);
  overflow: hidden;
}

.zoom-btn {
  display: -webkit-flex;
  display: flex;
  -webkit-align-items: center;
  align-items: center;
  -webkit-justify-content: center;
  justify-content: center;
  width: 100%;
  height: var(--zoom-w);
}
.zoom-hover { background-color: rgba(120, 120, 128, 0.2); }
.zoom-disabled { opacity: 0.32; }

.zoom-icon {
  width: var(--zoom-icon);
  height: var(--zoom-icon);
}

.zoom-hr {
  height: 1px;
  margin: 0 8px;
  background-color: rgba(60, 60, 67, 0.14);
}

/* ---------- 页脚（紧凑精致，自动贴合底部安全区） ---------- */
.footer {
  display: -webkit-flex;
  display: flex;
  -webkit-align-items: center;
  align-items: center;
  -webkit-justify-content: center;
  justify-content: center;
  -webkit-flex-shrink: 0;
  flex-shrink: 0;
  gap: 12px;
  padding: var(--footer-py) 12px calc(var(--footer-py) + env(safe-area-inset-bottom));
  background: var(--bg);
}

.footer-icon {
  width: var(--footer-icon);
  height: var(--footer-icon);
  border-radius: var(--footer-radius);
  -webkit-flex-shrink: 0;
  flex-shrink: 0;
  box-shadow: 0 2px 6px rgba(0, 0, 0, .08);
}

.footer-texts {
  display: -webkit-flex;
  display: flex;
  -webkit-flex-direction: column;
  flex-direction: column;
}

.footer-title-row {
  display: -webkit-flex;
  display: flex;
  -webkit-align-items: baseline;
  align-items: baseline;
  gap: 8px;
}

.footer-title {
  font-size: var(--title-size);
  font-weight: 600;
  line-height: 1.25;
  color: var(--text);
}
.footer-sub {
  margin-top: 3px;
  font-size: 12px;
  line-height: 1.35;
  color: var(--text2);
}
.footer-copy {
  font-size: 11px;
  line-height: 1.25;
  color: var(--text3);
}
